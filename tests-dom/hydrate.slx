// The board's pages, adopted by a real document.
//
// **The measurement is jsdom's own `MutationObserver` and nothing else would do.** Counting what
// `lath` asked the host to do would only say that `lath` believes it touched nothing; an observer is
// the browser's answer, and it sees a write the framework did not know it was making -- an attribute
// set to the value it already held, a text node rewritten with the same text.
//
// **The markup comes from the string host the server uses**, which is what makes the whitespace
// question answer itself: this is the page a browser is really sent.
//
// ## WHAT THESE ASK OF `lath`, AND WHY THE PAGE IS WRITTEN THE ORDINARY WAY
//
// **This whole file is four properties of `lath`'s hydration, applied to a real page.** Each one has
// its own reduction in `tests-dom/framework.slx` beside this file -- lath and a document and nothing
// else -- so a failure here is read there. Two of them decide whether the page can be adopted at all,
// because the markup a server writes has to be walkable back:
//
// - **Two text children in a row must not come back as one text node.** `<h2>{len(rows)} replies</h2>`
//   is two children in the tree and `2 replies` in the markup unless the markup marks the seam. React
//   writes a `<!-- -->` between them for exactly this reason.
// - **A text child that is the empty string must be decided the same way by both hosts.**
//   `<textarea>{value ?? ""}</textarea>` writes `<textarea></textarea>`, so a tree that made a node
//   for it would want one the page does not have.
//
// The other two are mutations rather than faults, and `A_HYDRATED_BOARD_MAKES_NO_MUTATIONS_AT_ALL`
// is what sees them: `value` written as a property with no comparison first (one record per hidden
// field, and a field somebody is typing in would be reset), and a numeric attribute -- `rows={5}` --
// compared against the page's `"5"`, disagreeing, and written again.
//
// **Nothing here is written around them.** `{n} replies` is the most ordinary thing a page says, and a
// board that spelled it `{string(n) + " replies"}` to get past a framework defect would be teaching
// the workaround to everybody who read it. All four were `lath` defects this board found; `lath`
// 0.5.1 answers all four, which is why these run.

import { createElement, createStore, Fragment, mount, hydrate, html, Provider, stringHost,
    useEffect, useState } from lath
import { domHost } from lath/dom
import { navigateWith } from lath/router
import { cookie, pushPath } from slate:dom

import { App } from "../app/pages.slx"
import { rendersOnServer } from "../app/shell.sl"
import { at, click, mutations, prevented, shown } from "./probe.slx"

val Ada = { id: 1, name: "ada", role: "admin", avatar: null, made: 1756900000 }

thread() -> object =
    { id: 7, title: "Hello from slate", body: "a first post", photo: null, replies: 2, author: 1,
      author_name: "ada", author_avatar: null, made: 1756900100, active: 1756900300,
      tags: ["slate", "lath"] }

reply(id: integer, said: string) -> object =
    { id: id, thread: 7, body: said, photo: null, author: 1, author_name: "ada",
      author_avatar: null, made: 1756900300 }

// **Every shape hydration has to walk, in one page**: attributes, text, nested elements, a keyed list
// built from data, components with contexts above them, forms, and a fragment in the header.
val Data = { page: "thread", thread: thread(), replies: [reply(1, "first"), reply(2, "second")] }

var sent = []

// Where the page's own navigator was asked to go, which is `client.slx`'s `go` seen from outside.
var moved = []

// What the page's own program does instead of letting the browser post a form.
async sending(action: string, fields: object) -> object
    push(sent, { action: action, fields: fields })

    { ok: true }

Page(props: object) =
    val out = <App nav={{ url: "/threads/7", go: null, replace: null }} data={Data} user={Ada}
                   csrf="a-token" send={sending}/>

    out

// What the server would have sent.
//
// **A FRESH `createStore()` PER CALL.** `mortar`'s theme atom lives in `defaultStore()` where
// nothing else provides one, and that store is one module-level value shared by every render in this
// process -- so a test that toggled it and left it dark would otherwise be what a later, unrelated
// test's "light" page hydrates against.
markup() -> string = html(mount(<Provider store={createStore()}><Page/></Provider>, stringHost()))

// **The page put back between tests**, so that what one test planted is never what the next one
// adopts. `sent` goes with it: a submit recorded by one test would otherwise be counted by the next.
@setup
anEmptyPage()
    sent = []
    moved = []

    at("")

// The message a call that is supposed to fail left behind.
//
// **`assertFaults` is what a must-fault test writes** and this is the one place it will not do:
// `MARKUP_THAT_DOES_NOT_MATCH` reads three things out of one sentence, where `assertFaults` compares
// one -- and asking it three times would hydrate a page three times, each attempt leaving the
// document in a state the next one did not mean to adopt.
fell(f) -> string
    var said = ""

    try
        f()
    catch e
        said = e.message

    said

@test
async A_HYDRATED_BOARD_MAKES_NO_MUTATIONS_AT_ALL()
    val was = markup()

    at(was)

    // The records for planting the markup are the harness's own; the measurement starts after them.
    await sleep(1)

    // **What the page is compared against is the PAGE and not the markup string**, and that is not a
    // weaker check: a browser that parsed `required` and serialised it back writes `required=""`, so
    // the markup a server sent and the page it became are two spellings of one document. Reading the
    // page before and after is what asks whether hydration changed it.
    val planted = shown()
    val before = mutations()

    hydrate(<Provider store={createStore()}><Page/></Provider>, domHost("#app"))

    await sleep(1)

    assertEq(mutations() - before, 0)

    // And what is on the page is still exactly what was there, character for character.
    assertEq(shown(), planted)

    // The markup really is the whole page and not a fragment of it, which is what says the comparison
    // above is over everything the server sent.
    assert(contains(planted, "<h2 class=\"count\">2 replies</h2>"))
    assert(contains(planted, "the slate stack, end to end."))

@test
async A_MOUNTED_RENDER_INTO_THE_SAME_MARKUP_RECORDS_PLENTY()
    // **The control**, and it is the way a measurement of "nothing happened" fails: without it the
    // zero above could be zero because the observer was watching the wrong thing.
    at(markup())

    await sleep(1)

    val before = mutations()

    mount(<Provider store={createStore()}><Page/></Provider>, domHost("#app"))

    await sleep(1)

    assert(mutations() - before > 0)

@test
async THE_FORMS_IT_ATTACHED_ACTUALLY_SUBMIT_WITHOUT_A_RELOAD()
    // **This is what hydration is FOR.** The markup a server sent is already the page; what it does
    // not have is a single event listener, and the tree that was walked is what installs them.
    at(markup())

    hydrate(<Provider store={createStore()}><Page/></Provider>, domHost("#app"))

    click("form.out", "submit")

    await sleep(1)

    assertEq(len(sent), 1)
    assertEq(sent[0].action, "/signout")
    assertEq(sent[0].fields._csrf, "a-token")
    assertEq(sent[0].fields.back, "/threads/7")

    // **`preventDefault` is what keeps the browser from posting the form as well**, and it is only
    // called where a sender was installed -- which is what makes the plain post the fallback rather
    // than a second code path.
    assert(prevented(), "the browser was told not to post it")

@test
async A_PAGE_WITH_NO_SENDER_LETS_THE_BROWSER_POST_THE_FORM()
    // **The fallback is not a fallback at all**: a submit handler that finds no sender does not call
    // `prevent`, so the browser posts the form itself and the server answers with the next page.
    Plain(props: object) =
        val out = <App nav={{ url: "/threads/7", go: null, replace: null }} data={Data}
                    user={Ada} csrf="a-token" send={null}/>

        out

    at(html(mount(<Provider store={createStore()}><Plain/></Provider>, stringHost())))

    hydrate(<Provider store={createStore()}><Plain/></Provider>, domHost("#app"))

    click("form.out", "submit")

    await sleep(1)

    assert(!prevented(), "the browser posts it, exactly as it would with no script on the page")

// -- the other half of what hydration attached ------------------------------------------------------

// **`client.slx`'s `Root`, in the two things about it these tests can hold.** It says what following a
// link means -- because on this board that costs a fetch and a `<html data-theme>` and not only a
// view -- and it keeps the URL in a `useState` of its own. Every page under it is the same `App` the
// server rendered.
//
// **What this catches is a page that moves its address bar and then does nothing.** The sort and the
// tag list on the front page read the query through `lath/dom`'s `usePath`, and until `lath` 0.5.2
// asking installed a navigator as a side effect: the last control to render owned the page's
// navigation, so a click re-rendered that control and the page never heard. It was invisible to every
// test here, because nothing drove a click through a `Link` with a page's own navigator installed, and
// invisible in `curl`, because the server was answering correctly the whole time.
//
// **The theme choice used to be exactly this kind of control and is not any more.** `mortar` 0.3.2
// moved it out of the query entirely -- it is a plain `Button` calling `useTheme()`'s setter, with no
// `useSearch` and nothing to ask the router for -- so it no longer stands in for this bug. What is
// worth pinning about it now is the opposite direction: that a page kept moving under a reader who
// had already chosen dark does not lose that choice, which is the test below.
Live(props: object) =
    val [url, setUrl] = useState("/threads/7")

    go(to, opts = null)
        push(moved, to)
        setUrl(to)

    wire()
        navigateWith(go)

        null

    useEffect(wire, [])

    val out = <App nav={{ url: url, go: go, replace: go }} data={Data} user={Ada} csrf="a-token"
                   send={sending}/>

    out

// What the server would have sent for the page above, with the address bar put where that page is.
//
// **`mount(<Live/>)` and not `Live({})`**: this one has hooks, and a component called outside a render
// has no instance to keep them on.
//
// **The address bar matters here and not in the tests above**, because a control that rewrites the
// query -- the theme choice -- builds the address it writes out of the one the page is really at. On
// the board the two are kept in step by `go`, which pushes before it sets; a test that planted the
// markup and left the address bar at `/` would be asking about a page that cannot happen.
living() -> string =
    pushPath("/threads/7")

    // **A fresh store here too**, for the same reason `markup()` above takes one: neither side of a
    // hydration pair passes a `theme` prop, so both have to start from the atom's own default and
    // not from whatever an earlier test's toggle left in `defaultStore()`.
    html(mount(<Provider store={createStore()}><Live/></Provider>, stringHost()))

@test
async A_LINK_IT_ATTACHED_REACHES_THE_PAGES_OWN_NAVIGATOR()
    at(living())

    hydrate(<Provider store={createStore()}><Live/></Provider>, domHost("#app"))

    click("a[href=\"/new\"]")

    await sleep(1)

    // **And the browser was told not to follow it**, which is what makes this a movement inside the
    // page rather than the reload it looks like from the outside.
    assertEq(moved, ["/new"])
    assert(prevented(), "the browser was told not to follow the link")

@test
async A_THEME_TOGGLE_WRITES_THE_COOKIE()
    at(markup())

    hydrate(<Provider store={createStore()}><Page/></Provider>, domHost("#app"))

    click("button[aria-label=\"Theme\"]")

    await sleep(1)

    assertEq(cookie("theme"), "dark")

@test
async A_DARK_THEME_SURVIVES_A_CLIENT_NAVIGATION()
    // **The theme is an atom now and not a query parameter**, so nothing about following a link
    // could touch it. `Live` is a stand-in for navigation alone and does not reproduce `client.slx`'s
    // own `<html data-theme>` sync, so what is asked here is `Theme`'s own rendered element, which
    // `App` always carries.
    at(living())

    hydrate(<Provider store={createStore()}><Live/></Provider>, domHost("#app"))

    click("button[aria-label=\"Theme\"]")

    await sleep(1)

    assertEq(contains(shown(), ">Light</button>"), true)
    assertEq(contains(shown(), "class=\"mortar board\" data-theme=\"dark\""), true)

    // **The router moving the page must not be what decides the colour.** `A_LINK_IT_ATTACHED_
    // REACHES_THE_PAGES_OWN_NAVIGATOR` above proves the click above reaches `go`; this asks what
    // happens to the atom while it does, which is nothing at all.
    click("a[href=\"/new\"]")

    await sleep(1)

    assertEq(moved, ["/new"])
    assertEq(contains(shown(), "class=\"mortar board\" data-theme=\"dark\""), true)

@test
MARKUP_THAT_DOES_NOT_MATCH_IS_A_FAULT_NAMING_THE_PATH_AND_BOTH_SIDES()
    // **There is no falling back to a client render**, which is the decision that makes hydration
    // worth having: a page that quietly rebuilt what it could not adopt would hide a server and a
    // client that disagree -- the one defect hydration exists to expose -- behind a page that looks
    // right.
    //
    // **What is bent is the HEADER and not the thread**, and that is not arbitrary: the thread view
    // stands inside a `Boundary`, which CATCHES a mismatch under it the way it catches any other
    // fault -- and then renders its fallback into markup that is not the fallback's, so what escapes
    // names the fallback's own first node instead of the disagreement. The header is above every
    // boundary on the page, so a mismatch there is the one this test means to describe.
    at(markup().replace("<a class=\"m-brand\"", "<b class=\"m-brand\""))

    val said = fell(() -> hydrate(<Provider store={createStore()}><Page/></Provider>, domHost("#app")))

    assert(contains(said, "the page does not match what was rendered"))
    assert(contains(said, "wants <a>"))
    assert(contains(said, "has <b>"))

// -- the one page the server does not render ------------------------------------------------------

// The composer, which is the page `rendersOnServer` answers `false` about.
val Composing = { page: "compose" }

Blank(props: object) =
    val out = <App nav={{ url: "/new", go: null, replace: null }} data={Composing} user={Ada}
                   csrf="a-token" send={sending}/>

    out

@test
async A_CLIENT_ONLY_PAGE_IS_BUILT_INTO_AN_EMPTY_CONTAINER()
    // **The empty container is what the server actually sends for this page**, `api/render.sl` asking
    // `rendersOnServer` and putting nothing in the document -- so this is the page a browser really
    // gets, and `mount` is what has to make something of it.
    assert(!rendersOnServer(Composing), "the composer is the client-only one")
    assert(rendersOnServer(Data), "and a thread is not")

    await sleep(1)

    // **The container and nothing in it**, which is the whole of what `api/render.sl` writes for this
    // page -- `shown()` being the container itself and not its children.
    assertEq(shown(), "<div id=\"app\"></div>")

    mount(<Provider store={createStore()}><Blank/></Provider>, domHost("#app"))

    await sleep(1)

    assert(contains(shown(), "Start a thread</h1>"), "the form is on the page now")
    assert(contains(shown(), "the slate stack, end to end."), "and so is the rest of the document")

    // **The sheets are the visible difference between the two arrangements.** A server-rendered page
    // carries its `<style>` inside the container, in front of the markup, so the first paint is
    // already styled; a mounted one has none to adopt and `lath`'s DOM host writes them into the
    // document's `<head>` instead -- which is why nothing here is in front of the form.
    assert(contains(markup(), "<style"), "the page the server renders carries its sheets")
    assert(!contains(shown(), "<style"), "and the one the browser builds has none in the container")

@test
async HYDRATING_AN_EMPTY_CONTAINER_IS_A_FAULT_WHICH_IS_WHY_ONE_FUNCTION_DECIDES()
    // **The two sides cannot be allowed to disagree**, and this is what disagreeing costs: a page the
    // server did not render, adopted anyway, faults on the first node it looks for. `rendersOnServer`
    // is asked by `api/render.sl` and by `client.slx` so that neither can decide it alone.
    //
    // **The container is empty because the setup emptied it**, which is what this page really gets.
    assertFaults(() -> hydrate(<Provider store={createStore()}><Blank/></Provider>, domHost("#app")))
