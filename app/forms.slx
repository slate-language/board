// Every form on the board.
//
// **A form here is a real `<form method="post">` and works with no script on the page**, which is the
// whole arrangement: the server answers a plain post with `303 See Other` and the next page, exactly
// as it did before anybody wrote a browser program. What hydration adds is a submit handler, and that
// handler only takes the submit where a sender was installed -- so the fallback is not a fallback at
// all, it is what happens when nothing intercepts.
//
// **The values live in refs and not in state**, so typing does not re-render the page it is typed on.
// A submit handler reads them at the moment it fires.
//
// **The controls are `mortar`'s.** A `Form` writes the CSRF field itself, a `Field` wires `for`/`id`
// between a label and its control and `aria-describedby`/`aria-invalid` to whatever went wrong with
// it, and a `Problem` renders an RFC 9457 document for a person. What is left here is which fields a
// form has and what happens when it is submitted.

import { createElement, Fragment, style, useContext, useRef, useState } from lath
import { Actions, Button, Confirm, Field, FileInput, Form, Problem, TextArea } from mortar

import { Nav, PostContext, Session } from "./context.sl"
import { into } from "./parts.slx"

import sheet from "./forms.css"

// -- what a submit handler is ---------------------------------------------------------------------

// `[note, onSubmit]` for a form posting `action`.
//
// `gather` answers the fields to send. `hold` answers `true` where this submit must be left to the
// browser -- which is what a chosen file means: **slate has no way to read a file out of an input**,
// so a form carrying one is posted by the browser as `multipart/form-data` and the page reloads.
export useForm(action: string, gather: function, hold = null) -> array =
    val session = useContext(Session)
    val post = useContext(PostContext)
    val [note, setNote] = useState(null)

    async sent(e: object)
        if post.send == null then return null
        if hold != null && hold() then return null

        e.prevent()
        setNote(null)

        var fields = gather()

        fields["_csrf"] = session.csrf

        val r = await post.send(action, fields)

        if r.ok then return null

        setNote(r.detail ?? "that did not work")

    [note, sent]

// The token every form of ours carries, read off the session.
//
// **A form is posted by a browser with no script running**, so the token cannot travel in a header --
// which is what `sluice`'s own `csrf` guard asks for, and what `Form`'s `csrf` prop writes as a
// hidden field. `api/forms.sl` takes either.
useToken() -> string =
    val session = useContext(Session)

    session.csrf

// -- signing in, and joining ------------------------------------------------------------------------

// One form for both, because they differ in three words and in nothing else.
export SignForm({ joining = false, detail = null, mismatch = [] }) =
    style(sheet)

    val name = useRef("")
    val password = useRef("")
    val action = if joining then "/signup" else "/signin"
    val csrf = useToken()

    gather() = { name: name.current, password: password.current }

    val form = useForm(action, gather)
    val note = form[0]
    val out = <Form class="card sign" action={action} csrf={csrf} onSubmit={form[1]}>
        <h1>{if joining then "Join the board" else "Sign in"}</h1>
        <Problem detail={note ?? detail} errors={mismatch}/>
        <Field name="name" label="Name" required autocomplete="username" onInput={into(name)}/>
        <Field name="password" label="Password" kind="password" required
               autocomplete={if joining then "new-password" else "current-password"}
               onInput={into(password)}/>
        <Actions><Button kind="submit">{if joining then "Join" else "Sign in"}</Button></Actions>
        <p class="aside">
            {if joining then "Already here? " else "New here? "}
            <a href={if joining then "/signin" else "/signup"}>
                {if joining then "Sign in" else "Make an account"}
            </a>
        </p>
    </Form>

    out

// -- a new thread ---------------------------------------------------------------------------------

export ThreadForm({ detail = null, mismatch = [] }) =
    style(sheet)

    val title = useRef("")
    val body = useRef("")
    val tags = useRef("")
    val photo = useRef("")
    val csrf = useToken()

    gather() = { title: title.current, body: body.current, tags: tags.current }

    chose() -> boolean = photo.current != ""

    val form = useForm("/threads", gather, chose)
    val note = form[0]
    val out = <Form class="card compose" action="/threads" csrf={csrf}
                    enctype="multipart/form-data" onSubmit={form[1]}>
        <h1>Start a thread</h1>
        <Problem detail={note ?? detail} errors={mismatch}/>
        <Field name="title" label="Title" required placeholder="What is this about?"
               onInput={into(title)}/>
        <TextArea name="body" label="Post" rows={8} required onInput={into(body)}/>
        <Field name="tags" label="Tags" placeholder="slate, sluice, lath" hint="Separated by commas."
               onInput={into(tags)}/>
        <FileInput name="photo" label="Photo" accept="image/*" onInput={into(photo)}/>
        <Actions><Button kind="submit">Post it</Button></Actions>
    </Form>

    out

// -- a reply --------------------------------------------------------------------------------------

export ReplyForm({ thread = 0 }) =
    style(sheet)

    val body = useRef("")
    val photo = useRef("")
    val action = "/threads/" + string(thread) + "/replies"
    val csrf = useToken()

    gather() = { body: body.current }

    chose() -> boolean = photo.current != ""

    val form = useForm(action, gather, chose)
    val note = form[0]
    val out = <Form class="card reply-form" action={action} csrf={csrf}
                    enctype="multipart/form-data" onSubmit={form[1]}>
        <h2>Reply</h2>
        <Problem detail={note}/>
        <TextArea name="body" label="Say something" rows={5} required onInput={into(body)}/>
        <FileInput name="photo" label="Photo" accept="image/*" onInput={into(photo)}/>
        <Actions><Button kind="submit">Post reply</Button></Actions>
    </Form>

    out

// -- a picture of oneself ---------------------------------------------------------------------------

// **This form never intercepts**, carrying nothing but a file. It is the plain post every form here
// falls back to, written out once with nothing else in it.
export AvatarForm(props: object) =
    style(sheet)

    val csrf = useToken()
    val out = <Form class="card avatar-form" action="/profile/avatar" csrf={csrf}
                    enctype="multipart/form-data">
        <FileInput name="photo" label="Your picture" accept="image/*" required/>
        <Actions><Button kind="submit">Use this</Button></Actions>
    </Form>

    out

// -- the one-button forms ---------------------------------------------------------------------------

// A post with no fields: signing out, revoking a session, deleting a post.
//
// **A button and not a link, because it changes something.** A `GET` that changed a row would be
// followed by every crawler and every link prefetcher there is.
//
// **An optional `confirm={ title, detail }` puts mortar's `Confirm` in front of the submit.** Given
// one, a click opens the dialog instead of posting, and only its own confirm button calls through;
// left off, the button posts exactly as it always did. `Confirm` renders nothing on the string host,
// so a delete link's server markup is unchanged either way.
export Doing(props: object) =
    val nav = useContext(Nav)
    val action = props.action
    val csrf = useToken()

    // **Resolved with `??` and never compared with `== null` directly** -- an omitted `confirm` reads
    // as slate's `undefined`, which is not `null` until something resolves it.
    val confirm = props.confirm ?? null

    // **Where to go afterwards travels in the form and not in `Referer`.** A handler that redirected
    // to whatever a browser said the last page was would be an open redirect, and a header a client
    // writes is exactly the wrong place to read a destination from; this is a path this program
    // rendered, and the handler still checks that it is one.
    gather() = { back: nav.url }

    val form = useForm(action, gather)
    val sent = form[1]

    val [asking, setAsking] = useState(false)

    guard(e: object) =
        if confirm == null then
            sent(e)
        else
            e.prevent()
            setAsking(true)

    confirmed() =
        setAsking(false)
        sent({ prevent: () -> null })

    val out = <Fragment>
        <Form class={"m-doing " + (props.class ?? "")} action={action} csrf={csrf}
                        onSubmit={guard}>
            <input type="hidden" name="back" value={nav.url}/>
            <Button kind="submit" variant={props.tone ?? "quiet"}>{props.label ?? "Do it"}</Button>
        </Form>
        {if confirm == null then null else
            <Confirm open={asking} title={confirm.title} detail={confirm.detail ?? null}
                     confirmLabel={props.label ?? "Confirm"} onConfirm={confirmed}
                     onCancel={() -> setAsking(false)}/>}
    </Fragment>

    out

// The search box in the header. **A `GET` form, so a search is a URL somebody can send to somebody
// else** -- and the one form here that changes nothing and therefore carries no token, which
// `mortar`'s `Form` refuses to let it: a double-submit token in the address bar of every search
// anybody sent to anybody else is the thing that check is about.
export SearchForm({ q = "" }) =
    val out = <Form class="m-search" action="/" method="get" label="Search">
        <Field name="q" kind="search" label="Search threads" value={q}
               placeholder="Search threads"/>
    </Form>

    out
