// The pages, the route table, and the one component both halves of the program mount.
//
// **Every page is a plain function of the contexts** -- who is signed in, what the server worked out
// for this URL, where the address is -- and reaches for nothing else. That is what lets the server
// render each of them to markup and the browser adopt the same markup and carry on: `server.sl` and
// `client.slx` differ in the values they hand the providers and in nothing about the pages.
//
// **What a page is MADE of is `mortar`**, and what is written here is what this board is: which rows
// go in the list, what a thread page holds, and where the filters sit. Each page brings its own
// stylesheet with `style(css)`, which is layout and nothing else -- the colour, the type, the
// spacing scale, the focus ring and both themes are the library's, and no rule here writes one.

import { createElement, Fragment, Boundary, memo, style, useContext } from lath
import { Anything, Link, router, useSearch, withSearch } from lath/router
import { Avatar, Button, CardList, EmptyState, Live, Page, Pagination, Post, PostList, Problem,
         SortControls, TagList, Theme, Timestamp, useTheme } from mortar

import { Board, Nav, PostContext, Session } from "./context.sl"
import { Card, Original, pictureOf, tagged } from "./parts.slx"
import { AvatarForm, Doing, ReplyForm, SearchForm, SignForm, ThreadForm } from "./forms.slx"

import shell from "./shell.css"
import listing from "./list.css"
import conversation from "./thread.css"
import people from "./profile.css"
import staff from "./admin.css"

// -- what a page shows while its data is on the way ------------------------------------------------

// **The browser fetches a page's data after the address has already moved**, so for one turn the
// router is showing a view whose data belongs to the page before it. Each view says which page it is
// for, and this is what stands in the gap.
export Pending(props: object) =
    val out = <Live><p class="pending">Fetching...</p></Live>

    out

// -- the thread list ---------------------------------------------------------------------------------

// The three orders a board may be read in. **A record per option and not a bare word**, two of the
// three reading as something other than their key.
val Orders = [{ value: "newest", label: "newest" },
              { value: "active", label: "recently active" },
              { value: "busiest", label: "most replies" }]

export List(props: object) =
    style(listing)

    val board = useContext(Board)

    if board.page != "list" then return Pending({})

    val nav = useContext(Nav)
    val search = useSearch()
    val query = search[0]
    val set = search[1]
    val list = board.threads
    val rows = list.rows
    val on = board.tag ?? ""
    val labels = (board.tags ?? []).map((t) -> { label: t.tag, count: t.count })
    val one = (t) -> <Card key={t.id} thread={t}/>

    // **A filter and a sort order are a REAL ANCHOR carrying the whole address they would go to**,
    // which is what `href` is for, and the click is taken by `onChoose` only where a page is
    // hydrated. So the board sorts and filters with no script running, a cmd-click opens the
    // filtered list in a tab, and nothing about either is a special case.
    //
    // **Choosing the tag already in force clears it**, which is what `tag: null` says: `lath` leaves
    // a member whose value is `null` out of the query it writes, so that is how a name comes off an
    // address.
    //
    // **`query with { … }` and not `{ … }`, because `useSearch`'s setter takes the WHOLE query** --
    // and so does `withSearch`, the two being one function read in each direction. What that buys is
    // that a control says which members it changes and nothing about the ones it does not: choosing a
    // sort keeps the tag, the search text and the colour the reader is in, and the same expression is
    // the anchor's `href` and the handler's argument.
    changed(over: object) -> object = query with over

    sorted(v: string) -> string = withSearch(nav.url, changed({ sort: v, page: null }))
    tagHref(t: string) -> string = withSearch(nav.url, changed({ tag: if t == on then null else t,
                                                                 page: null }))
    paged(n: integer) -> string = withSearch(nav.url, changed({ page: n }))

    choseSort(v: string) = set(changed({ sort: v, page: null }))
    choseTag(t: string) = set(changed({ tag: if t == on then null else t, page: null }))
    chosePage(n: integer) = set(changed({ page: n }))

    // **A block `if` is bound to a name before the tag rather than written inside a hole.** A hole
    // takes an expression, and slate's block `if` is a statement -- so this is the shape every
    // either-or in this file has.
    val cards = if len(rows) == 0
        <EmptyState title="Nothing here yet" detail="No thread matches what you asked for.">
            <Link to="/new">Start one</Link>
        </EmptyState>
    else
        <CardList>{rows.map(one)}</CardList>

    val out = <div class="page list">
        <div class="controls">
            <SortControls options={Orders} sort={board.sort ?? "newest"} href={sorted}
                          onChoose={choseSort}/>
            <TagList tags={labels} href={tagHref} current={if on == "" then null else on}
                     onChoose={choseTag}/>
        </div>
        {cards}
        <Pagination page={list.page} size={list.size} total={list.total} href={paged}
                    onChoose={chosePage} unit="threads"/>
    </div>

    out

// -- one thread ----------------------------------------------------------------------------------

reply(props: object) =
    val r = props.reply
    val drop = if props.mine ?? false
        <Doing class="drop" action={"/replies/" + string(r.id) + "/delete"} label="Delete"
               tone="danger"/>
    else
        null

    val out = <Post compact name={r.author_name} src={pictureOf(r.author_avatar)}
                    authorHref={"/people/" + r.author_name} at={r.made} body={r.body}
                    photo={pictureOf(r.photo)} alt={"a photo by " + r.author_name}>
        <Original file={r.photo}/>
        {drop}
    </Post>

    out

// **Keyed by the row's id and memoised**, which is the pair that makes a live thread insert one reply
// rather than rewrite the list: the key is what the reconciler matches on and `memo` is what keeps a
// row that did not change from being rendered again.
val Reply = memo(reply)

// **The thread view is inside a `Boundary`.** A row the server sent that this page cannot render is a
// defect in the program and stays a fault -- what a boundary buys is that the rest of the page, the
// header and the reply form included, is still there to read while it is fixed.
export Thread(props: object) =
    style(conversation)

    val board = useContext(Board)

    if board.page != "thread" then return Pending({})

    val out = <Boundary fallback={broken}><ThreadView/></Boundary>

    out

broken(e: object) =
    val out = <Problem title="This thread could not be shown." detail={e.message}/>

    out

ThreadView(props: object) =
    val board = useContext(Board)
    val session = useContext(Session)
    val t = board.thread
    val rows = board.replies
    val admin = session.user != null && session.user.role == "admin"
    val one = (r) -> <Reply key={r.id} reply={r} mine={admin || mine(session, r)}/>

    val drop = if admin
        <Doing class="drop" action={"/threads/" + string(t.id) + "/delete"} label="Delete thread"
               tone="danger"/>
    else
        null

    val below = if session.user == null
        <p class="hint"><Link to="/signin">Sign in</Link> to reply.</p>
    else
        <ReplyForm thread={t.id}/>

    val out = <div class="page thread">
        <Post title={t.title} name={t.author_name} src={pictureOf(t.author_avatar)}
              authorHref={"/people/" + t.author_name} at={t.made} body={t.body}
              photo={pictureOf(t.photo)} alt={t.title} tags={t.tags ?? []} tagHref={tagged}>
            <Original file={t.photo}/>
            {drop}
        </Post>
        <h2 class="count">{len(rows)} replies</h2>
        <PostList>{rows.map(one)}</PostList>
        {below}
    </div>

    out

mine(session: object, r: object) -> boolean =
    session.user != null && session.user.id == r.author

// -- the forms that are pages ------------------------------------------------------------------------

export Compose(props: object) =
    val board = useContext(Board)
    val session = useContext(Session)

    if board.page != "compose" then return Pending({})
    if session.user == null then return needSignIn()

    val out = <div class="page compose">
        <ThreadForm detail={board.detail ?? null} mismatch={board.mismatch ?? []}/>
    </div>

    out

needSignIn() =
    val out = <div class="page hint">
        <EmptyState title="Members write the threads" detail="Signing in takes a moment.">
            <Link to="/signin">Sign in</Link>
        </EmptyState>
    </div>

    out

export SignIn(props: object) =
    val board = useContext(Board)
    val out = <div class="page sign-page">
        <SignForm detail={board.detail ?? null} mismatch={board.mismatch ?? []}/>
    </div>

    out

export SignUp(props: object) =
    val board = useContext(Board)
    val out = <div class="page sign-page">
        <SignForm joining detail={board.detail ?? null} mismatch={board.mismatch ?? []}/>
    </div>

    out

// -- somebody's page -------------------------------------------------------------------------------

export Profile(props: object) =
    style(people)

    val board = useContext(Board)
    val session = useContext(Session)

    if board.page != "profile" then return Pending({})

    val who = board.who
    val threads = board.threads
    val replies = board.replies
    val itsMe = session.user != null && session.user.id == who.id
    val aThread = (t) -> <li key={t.id}><Link to={"/threads/" + string(t.id)}>{t.title}</Link>
        <Timestamp at={t.made}/></li>
    val aReply = (r) -> <li key={r.id}><Link to={"/threads/" + string(r.thread)}>{r.thread_title}</Link>
        <Timestamp at={r.made}/></li>
    val picture = if itsMe then <AvatarForm/> else null

    val started = if len(threads) == 0
        <p class="empty">None yet.</p>
    else
        <ul class="own">{threads.map(aThread)}</ul>

    val said = if len(replies) == 0
        <p class="empty">None yet.</p>
    else
        <ul class="own">{replies.map(aReply)}</ul>

    val out = <div class="page profile">
        <header class="who">
            <Avatar name={who.name} src={pictureOf(who.avatar)} size="large"/>
            <div class="named">
                <h1>{who.name}</h1>
                <p class="role">{who.role} since <Timestamp at={who.made}/></p>
            </div>
        </header>
        {picture}
        <section class="posts">
            <h2>Threads</h2>
            {started}
            <h2>Replies</h2>
            {said}
        </section>
    </div>

    out

// -- the admin page --------------------------------------------------------------------------------

export Admin(props: object) =
    style(staff)

    val board = useContext(Board)
    val session = useContext(Session)

    if board.page != "admin" then return Pending({})
    if session.user == null || session.user.role != "admin" then return refused()

    val everybody = board.users
    val live = board.sessions
    val aPerson = (u) -> <tr key={u.id}>
        <td><Link to={"/people/" + u.name}>{u.name}</Link></td>
        <td>{u.role}</td>
        <td><Timestamp at={u.made}/></td>
    </tr>
    val aSession = (s) -> <tr key={s.id}>
        <td class="who">{s.name}</td>
        <td><Timestamp at={s.at}/></td>
        <td><Doing class="drop" action={"/admin/sessions/" + s.id + "/revoke"} label="Revoke"
                   tone="danger"/></td>
    </tr>
    val open = if len(live) == 0
        <p class="empty">Nobody is signed in.</p>
    else
        <div class="rows">
            <table class="sessions">
                <thead><tr><th>Who</th><th>Since</th><th></th></tr></thead>
                <tbody>{live.map(aSession)}</tbody>
            </table>
        </div>

    val out = <div class="page admin">
        <h1>Admin</h1>
        <section>
            <h2>People</h2>
            <div class="rows">
                <table class="people">
                    <thead><tr><th>Name</th><th>Role</th><th>Joined</th></tr></thead>
                    <tbody>{everybody.map(aPerson)}</tbody>
                </table>
            </div>
        </section>
        <section>
            <h2>Sessions</h2>
            {open}
        </section>
    </div>

    out

refused() =
    val out = <div class="page hint">
        <EmptyState title="That page is for administrators"
                    detail="Nothing here is yours to see."/>
    </div>

    out

// -- nothing there ---------------------------------------------------------------------------------

export Missing(props: object) =
    val out = <div class="page missing">
        <EmptyState title={"Nothing at " + (props.at ?? "/")}
                    detail="The thread may have been deleted, or the address mistyped.">
            <Link to="/">Back to the board</Link>
        </EmptyState>
    </div>

    out

// -- the routes ------------------------------------------------------------------------------------

// **One table, imported by the server and by the page.** `lath/router` is handed a path and never
// reads one, which is what lets these render in both places; what differs is `req.path` on one side
// and `usePath()` on the other.
export val routes = [
    { path: "/", view: (m) -> <List/> },
    { path: "/new", view: (m) -> <Compose/> },
    { path: "/signin", view: (m) -> <SignIn/> },
    { path: "/signup", view: (m) -> <SignUp/> },
    { path: "/threads/:id", view: (m) -> <Thread id={m.params.id}/> },
    { path: "/people/:name", view: (m) -> <Profile name={m.params.name}/> },
    { path: "/admin", view: (m) -> <Admin/> },
    { path: Anything, view: (m) -> <Missing at={m.path}/> },
]

// -- the theme -------------------------------------------------------------------------------------

// **THE THEME IS A COOKIE NOW, WHICH IS WHY THIS IS ONE BUTTON AND NOT TWO ANCHORS.** A reader's
// choice belongs to them and not to the page they were on, so `mortar` keeps it in `useTheme()`'s
// atom and writes it back to a cookie itself; there is nothing here to link to any more, only a
// setter to call.
ThemeChoice(props: object) =
    val [theme, setTheme] = useTheme()

    toggle()
        setTheme(if theme == "light" then "dark" else "light")

        null

    val out = <Button class="theme" variant="quiet" onClick={toggle} label="Theme">
        {if theme == "light" then "Dark" else "Light"}
    </Button>

    out

// -- the frame -------------------------------------------------------------------------------------

// What the header carries about the reader: who they are, and what they may do.
Me(props: object) =
    val session = useContext(Session)
    val you = session.user

    val boss = if you != null && you.role == "admin"
        <Link class="plain" to="/admin">Admin</Link>
    else
        null

    val who = if you == null
        <Fragment>
            <Link class="plain" to="/signin">Sign in</Link>
            <Link class="plain join" to="/signup">Join</Link>
        </Fragment>
    else
        <Fragment>
            <Link class="plain" to="/new">New thread</Link>
            <Link class="plain who" to={"/people/" + you.name}>
                <Avatar name={you.name} src={pictureOf(you.avatar)}/>{you.name}
            </Link>
            {boss}
            <Doing class="out" action="/signout" label="Sign out"/>
        </Fragment>

    val out = <Fragment>{who}<ThemeChoice/></Fragment>

    out

// The search box, as the header's own slot.
Find(props: object) =
    val board = useContext(Board)
    val out = <SearchForm q={board.q ?? ""}/>

    out

// The header, the content and the footer, with the board's own sheet on them.
//
// **A component and not four lines inside `App`, because `style(css)` may only be called while
// something is rendering** -- and `App` is *called* by the server rather than rendered, `mount` being
// handed the element it answers. So the board's shell sheet is registered here, one level in, where
// there is a render to register it against.
//
// **It also puts the sheet after `mortar`'s**, which is what a rule of this board's meant to override
// a rule of the library's needs: two selectors of the same weight are decided by which sheet came
// last, and `Theme` renders before this does.
Frame(props: object) =
    style(shell)

    val out = <Page brand="the board" search={<Find/>} nav={<Me/>}
                    footer={<p>sluice, lath, mortar and pg -- the slate stack, end to end.</p>}>
        {props.children ?? []}
    </Page>

    out

// The whole page below the document: the providers, the frame, the routed view and the footer.
//
// **This is what both hosts mount.** `server.sl` renders it through `lath`'s string host and puts the
// markup inside `<div id="app">`; `client.slx` hydrates the same element against that markup.
//
// **`Theme` is the outermost thing on the page**, which is what every stylesheet in `mortar` selects
// a dark page on. **`props.theme` only SEEDS it**, once, from whatever the request's cookie said --
// `api/render.sl` reads that cookie and `client.slx` hydrates against the same value, so the first
// paint and the adopted page agree; `useTheme()`'s own setter, called from `ThemeChoice` below, owns
// the colour from then on and `Theme` writes the cookie back itself when it changes.
export App(props: object) =
    val nav = props.nav ?? { url: "/", go: null, replace: null }
    val session = { user: props.user ?? null, csrf: props.csrf ?? "" }
    val out = <Nav.Provider value={nav}>
        <PostContext.Provider value={{ send: props.send ?? null }}>
            <Session.Provider value={session}>
                <Board.Provider value={props.data ?? { page: "missing", at: "/" }}>
                    <Theme theme={props.theme ?? null} class="board">
                        <Frame>{router(routes, nav.url)}</Frame>
                    </Theme>
                </Board.Provider>
            </Session.Provider>
        </PostContext.Provider>
    </Nav.Provider>

    out
