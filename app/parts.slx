// The few pieces of the board that `mortar` does not already own.
//
// **This file used to be the board's own component library and is now four things**, which is what
// installing `mortar` bought: the avatar, the byline, the timestamp, the photo, the tag pills, the
// sort control, the pager, the fields, the problem document and the thread card were all written
// here once, and every one of them is now a component with its own stylesheet, its own prop checks
// and its own accessibility. What is left is what is genuinely this board's.
//
// **Nothing here imports a host**, so each of these renders to markup on the server and into the
// document in a browser, and `tests/pages.sl` asserts the markup one of them made with no document
// anywhere.

import { createElement, memo } from lath
import { ThreadCard } from mortar

// -- a thread, in a list --------------------------------------------------------------------------

// Where a tag goes as an address.
//
// **A module-level function and not a lambda built per render**, which is what makes the `memo`
// below worth anything: a fresh closure handed down as a prop is a prop that differs on every
// render, and a memoised component whose props always differ is a memoised component that always
// renders.
export tagged(t: string) -> string = "/?tag=" + t

card(props: object) =
    val t = props.thread
    val out = <ThreadCard title={t.title} href={"/threads/" + string(t.id)}
                          name={t.author_name} src={pictureOf(t.author_avatar)}
                          authorHref={"/people/" + t.author_name} at={t.made}
                          excerpt={excerpt(t.body)} tags={t.tags ?? []} tagHref={tagged}
                          replies={t.replies}/>

    out

// **Memoised, and the key is the row's id**, which is the pair that makes a re-ordered list move its
// rows rather than rewrite them: the key is what the reconciler matches on, and `memo` is what stops a
// row that did not change being rendered again.
export val Card = memo(card)

excerpt(body: string) -> string =
    val one = replace(trim(body), "\n", " ")

    if len(one) <= 160 then one else one[0..<160] + "..."

// -- what the store keeps, as what a component takes ------------------------------------------------

// A row's file name as a URL, or `null` where there is no file.
//
// **The store keeps a PATH and a component takes a `src`**, and this is the one line between them:
// `/uploads/` is where `api/routes.sl` answers a photograph from, and a component has no business
// knowing that.
//
// **`?display` asks for the copy this board made to be looked at** -- a WebP at the width of the
// column, or the square an avatar is drawn in -- where the bare address is the file somebody posted,
// which is what a *view original* link follows. A picture with no display copy answers the same
// bytes at both, so nothing here has to know which kind it is holding.
export pictureOf(file) = if file == null then null else "/uploads/" + string(file) + "?display"

// Where the picture somebody actually posted is, which is the same address without the question.
export originalOf(file) = if file == null then null else "/uploads/" + string(file)

// -- forms ------------------------------------------------------------------------------------------

// What an `onInput` is for a field whose value lives in a ref.
//
// **A named inner function and not a lambda**, an assignment not being an expression and a lambda's
// one-line body being one.
export into(cell: object) -> function
    typed(e: object)
        cell.current = e.value

    typed
